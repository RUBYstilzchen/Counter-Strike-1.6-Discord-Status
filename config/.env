# Токен вашого Discord бота
DISCORD_TOKEN=your_discord_bot_token_here

# ID вашого Discord акаунту для сповіщень у приват
ADMIN_DISCORD_ID=123456789012345678

# Налаштування ігрового сервера
CS_SERVER_IP=127.0.0.1
CS_SERVER_PORT=27015

# Інтервал оновлення статусу в мілісекундах (30000 мс = 30 сек)
UPDATE_INTERVAL_MS=30000